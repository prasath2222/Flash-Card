{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user study progress, streak, learned cards, active deck and deleted cards for cross-device sync",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "lastActiveCardNum": {
          "type": "number"
        },
        "activeDeckId": {
          "type": "string",
          "maxLength": 128
        },
        "streakCount": {
          "type": "number"
        },
        "lastStudyDate": {
          "type": "string",
          "maxLength": 64
        },
        "learnedCardNums": {
          "type": "array",
          "description": "List of learned card numbers"
        },
        "deletedCardNums": {
          "type": "array",
          "description": "List of deleted card numbers"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "updatedAt"
      ]
    },
    "CustomShortcut": {
      "title": "CustomShortcut",
      "description": "Custom mnemonic shortcuts per flashcard created by the user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "cardNum": {
          "type": "number"
        },
        "es": {
          "type": "string",
          "maxLength": 500
        },
        "hi": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "cardNum",
        "updatedAt"
      ]
    },
    "CustomDeck": {
      "title": "CustomDeck",
      "description": "Custom uploaded decks and curriculum for trilingual study",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "deckId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "cardCount": {
          "type": "number"
        },
        "cards": {
          "type": "array",
          "description": "List of parsed flashcards in this deck"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "deckId",
        "title",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with study progress and preferences for cross-device synchronization"
    },
    "/users/{userId}/customShortcuts/{cardNum}": {
      "schema": "CustomShortcut",
      "description": "User-defined custom translations and mnemonic shortcuts per card"
    },
    "/users/{userId}/decks/{deckId}": {
      "schema": "CustomDeck",
      "description": "User uploaded custom flashcard decks synced across devices"
    }
  }
}
