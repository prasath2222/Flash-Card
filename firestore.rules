rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unlisted access
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document for health checks
    match /test/connection {
      allow read: if true;
    }

    // Cross-device synchronization state (supports both authenticated and global sync profiles)
    match /study_state/{syncKey} {
      allow read, write: if true;
    }

    // Custom card shortcuts and mnemonics
    match /custom_shortcuts/{docId} {
      allow read, write: if true;
    }

    // Custom uploaded decks
    match /custom_decks/{docId} {
      allow read, write: if true;
    }

    // User Study Profile for Cross-Device Synchronization
    match /users/{userId} {
      allow read, write: if true;

      match /customShortcuts/{cardNum} {
        allow read, write: if true;
      }

      match /decks/{deckId} {
        allow read, write: if true;
      }
    }

    // Production User Progress records
    match /user_progress/{userId} {
      allow read, write: if true;
    }
  }
}
